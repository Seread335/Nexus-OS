# Meta package: installs metasploit-framework (Nexus OS)
# Use this if you want "metasploit" as the package name; the real build is in metasploit-framework/.

pkgname=metasploit
pkgver=1.0
pkgrel=1
pkgdesc="Meta package for Metasploit Framework - penetration testing (pulls metasploit-framework)"
arch=('any')
url="https://www.metasploit.com/"
license=('BSD')
depends=('metasploit-framework')
# No source; meta package only
source=()
sha256sums=()

package() {
  install -d "$pkgdir/usr/share/doc/$pkgname"
  echo "This package provides 'metasploit' by depending on metasploit-framework. Use msfconsole, msfvenom, msfdb from that package." \
    > "$pkgdir/usr/share/doc/$pkgname/README"
}

