# PKGBUILD for BeEF (Browser Exploitation Framework)
# Maintainer: Nexus OS Team

pkgname=beef
pkgver=0.6.0.0
pkgrel=1
pkgdesc="The Browser Exploitation Framework (BeEF)"
arch=('any')
url="https://beefproject.com/"
license=('GPL')
depends=('ruby' 'nodejs' 'sqlite')
makedepends=('git' 'rubygems')
options=('!strip')
# Pin to specific commit for reproducibility (v0.6.0.0 tag)
_commit=6f7a319
source=("git+https://github.com/beefproject/beef.git#commit=${_commit}")
sha256sums=('SKIP')

prepare() {
  cd "${srcdir}/beef"
  # Clean up any potential git leftovers
  git clean -fdx
  
  # Install dependencies into vendor/bundle
  bundle config set --local deployment 'true'
  bundle config set --local without 'test development'
  bundle install
}

package() {
  cd "${srcdir}/beef"
  
  install -d "${pkgdir}/opt/beef"
  cp -a . "${pkgdir}/opt/beef"
  
  # Install launcher script
  install -d "${pkgdir}/usr/bin"
  cat > "${pkgdir}/usr/bin/beef" <<EOF
#!/bin/bash
cd /opt/beef
./beef "\$@"
EOF
  chmod 755 "${pkgdir}/usr/bin/beef"
}

