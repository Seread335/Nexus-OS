# PKGBUILD for Ghidra (AUR)

pkgname=ghidra
pkgver=10.2.2
pkgrel=1
pkgdesc="Ghidra Reverse Engineering Framework (binary distribution)"
arch=('x86_64')
url="https://ghidra-sre.org/"
license=('GPL')
depends=('jdk-openjdk')
source=("https://ghidra-sre.org/ghidra_${pkgver}.zip")
sha256sums=('SKIP')

prepare() {
  mkdir -p "$srcdir/ghidra"
  unzip -q "${srcdir}/ghidra_${pkgver}.zip" -d "$srcdir/ghidra"
}

build() {
  # No compile step; packaged as binary
  return 0
}

package() {
  local _dir="$srcdir/ghidra/ghidra_${pkgver}"

  # Install into /opt to avoid collisions and keep versioned path
  install -d "$pkgdir/opt"
  cp -a "${_dir}" "$pkgdir/opt/ghidra-${pkgver}"

  # Small wrapper to invoke the packaged ghidraRun
  install -d "$pkgdir/usr/bin"
  cat > "$pkgdir/usr/bin/ghidra" <<'EOF'
#!/bin/sh
exec /opt/ghidra-${pkgver}/ghidraRun "$@"
EOF
  install -m755 "$pkgdir/usr/bin/ghidra" "$pkgdir/usr/bin/ghidra"

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 README.TXT "$pkgdir/usr/share/doc/${pkgname}/README.TXT" || true
}
