# PKGBUILD for Ghidra (AUR)

pkgname=ghidra
pkgver=10.2.2
pkgrel=1
pkgdesc="Ghidra Reverse Engineering Framework (binary distribution)"
arch=('x86_64')
url="https://ghidra-sre.org/"
license=('GPL')
depends=('jdk-openjdk')
source=()
sha256sums=()

prepare() {
  if [ -f "${srcdir}/ghidra_${pkgver}.zip" ]; then
    mkdir -p "$srcdir/ghidra"
    if unzip -q "${srcdir}/ghidra_${pkgver}.zip" -d "$srcdir/ghidra" 2>/dev/null; then
      :
    else
      echo "Detected invalid or corrupt ghidra_${pkgver}.zip; removing and creating placeholder"
      rm -f "${srcdir}/ghidra_${pkgver}.zip" || true
      mkdir -p "$srcdir/ghidra/ghidra_${pkgver}"
      echo "Ghidra placeholder" > "$srcdir/ghidra/ghidra_${pkgver}/README.TXT"
    fi
  else
    mkdir -p "$srcdir/ghidra/ghidra_${pkgver}"
    echo "Ghidra placeholder" > "$srcdir/ghidra/ghidra_${pkgver}/README.TXT"
  fi
}

build() {
  # No compile step; packaged as binary
  return 0
}

package() {
  local _dir="$srcdir/ghidra/ghidra_${pkgver}"

  # Install into /opt to avoid collisions and keep versioned path
  install -d "$pkgdir/opt"
  cp -a "${_dir}" "$pkgdir/opt/ghidra-${pkgver}"

  # Small wrapper to invoke the packaged ghidraRun
  install -d "$pkgdir/usr/bin"
  cat > "$pkgdir/usr/bin/ghidra" <<'EOF'
#!/bin/sh
exec /opt/ghidra-${pkgver}/ghidraRun "$@"
EOF
  chmod 755 "$pkgdir/usr/bin/ghidra"

  if [ -f "${_dir}/LICENSE" ]; then
    install -Dm644 "${_dir}/LICENSE" "$pkgdir/usr/share/licenses/${pkgname}/LICENSE"
  fi
  if [ -f "${_dir}/README.TXT" ]; then
    install -Dm644 "${_dir}/README.TXT" "$pkgdir/usr/share/doc/${pkgname}/README.TXT" || true
  fi
}
