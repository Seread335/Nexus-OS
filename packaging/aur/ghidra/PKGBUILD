# PKGBUILD for Ghidra (Nexus OS verified)
# Maintainer: Nexus OS Team

pkgname=ghidra
pkgver=11.0.1
_pkgdate=20240130
pkgrel=1
pkgdesc="Ghidra Reverse Engineering Framework (binary distribution)"
arch=('x86_64')
url="https://ghidra-sre.org/"
license=('Apache')
depends=('jdk-openjdk>=17')
options=('!strip')
source=("https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_${pkgver}_build/ghidra_${pkgver}_PUBLIC_${_pkgdate}.zip")
sha256sums=('af43e8cfb2fa4490cf6020c3a2bde25c159d83f45236a0542688a024e8fc1941')

package() {
  local _dirname="ghidra_${pkgver}_PUBLIC"
  
  install -d "${pkgdir}/opt"
  cp -a "${srcdir}/${_dirname}" "${pkgdir}/opt/ghidra"
  
  # Wrapper
  install -d "${pkgdir}/usr/bin"
  cat > "${pkgdir}/usr/bin/ghidra" <<EOF
#!/bin/bash
exec /opt/ghidra/ghidraRun "\$@"
EOF
  chmod 755 "${pkgdir}/usr/bin/ghidra"
  
  # Desktop file (optional but good for "Monster" UX)
  install -d "${pkgdir}/usr/share/applications"
  cat > "${pkgdir}/usr/share/applications/ghidra.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=Ghidra
Comment=Software Reverse Engineering Framework
Icon=/opt/ghidra/support/ghidra.ico
Exec=/usr/bin/ghidra
Terminal=false
Categories=Development;Security;
EOF
}
