# PKGBUILD for hashcat (AUR) - binary-first packaging

pkgname=hashcat
pkgver=6.2.6
pkgrel=1
pkgdesc="Advanced GPU-based password recovery"
arch=('x86_64')
url="https://hashcat.net/hashcat/"
license=('MIT')
depends=('ocl-icd' 'libpcap')
makedepends=('p7zip')
source=("https://hashcat.net/files/hashcat-${pkgver}.7z")
sha256sums=('SKIP')

prepare() {
  cd "$srcdir"
  # Prefer a local artifact if present
  if [[ -f "hashcat-${pkgver}.7z" ]]; then
    echo "Using local or downloaded hashcat-${pkgver}.7z"
    7z x "hashcat-${pkgver}.7z" -o"$srcdir/hashcat" >/dev/null || true
  else
    echo "No archive found; will attempt to fetch source archive"
    mkdir -p "$srcdir/hashcat"
  fi
}

build() {
  # No compile step for binary distribution
  return 0
}

package() {
  cd "$srcdir"
  local _dir="$srcdir/hashcat"
  # Install into /opt to keep the installation tidy
  install -d "$pkgdir/opt"
  cp -a "${_dir}" "$pkgdir/opt/hashcat-${pkgver}"

  # Wrapper script
  install -d "$pkgdir/usr/bin"
  cat > "$pkgdir/usr/bin/hashcat" <<'EOF'
#!/bin/sh
exec /opt/hashcat-6.2.6/hashcat "$@"
EOF
  install -m755 "$pkgdir/usr/bin/hashcat" "$pkgdir/usr/bin/hashcat"

  # Docs and license (if present)
  install -Dm644 "$pkgdir/opt/hashcat-${pkgver}/README.md" "$pkgdir/usr/share/doc/${pkgname}/README.md" 2>/dev/null || true
  install -Dm644 "$pkgdir/opt/hashcat-${pkgver}/LICENSE" "$pkgdir/usr/share/licenses/${pkgname}/LICENSE" 2>/dev/null || true
}

# vim:set ts=2 sw=2 et:
