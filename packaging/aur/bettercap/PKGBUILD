# PKGBUILD for Bettercap (Binary Release)
# Maintainer: Nexus OS Team

pkgname=bettercap
pkgver=2.41.5
pkgrel=1
pkgdesc="Bettercap - Swiss Army Knife for Network Attacks and Monitoring"
arch=('x86_64')
url="https://www.bettercap.org/"
license=('GPL3')
depends=('libpcap' 'libusb' 'net-tools' 'iproute2')
options=('!strip')
source=("${pkgname}_v${pkgver}_linux_amd64.zip::https://github.com/bettercap/bettercap/releases/download/v${pkgver}/bettercap_linux_amd64.zip")
sha256sums=('563e16919e87e436f0b69d0ad8240595ed76d97ef154ae542933af332359346d')

package() {
  install -d "${pkgdir}/usr/bin"
  install -m755 "bettercap" "${pkgdir}/usr/bin/bettercap"
  
  # Install UI if included or needed (optional)
  # install -d "${pkgdir}/usr/share/${pkgname}"
}
